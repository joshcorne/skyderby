# Docker Environment Variables - TEMPLATE FILE
# 
# NOTE: This is a template file for reference only.
# All environment variables are already configured in docker-compose.yml with sensible defaults.
# 
# To override defaults:
#   1. Create a .env file in the project root (not .env.docker)
#   2. Add your custom values there
#   3. Docker Compose will automatically use them
#
# For production, generate a secure SECRET_KEY_BASE with:
#   docker run --rm skyderby bundle exec rails secret
SECRET_KEY_BASE=development_secret_key_base_minimum_length_required_is_64_characters_long_please_change_in_production

# Database (defaults are in docker-compose.yml)
# DB_NAME=skyderby_production
# DB_HOST=db
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# Redis (defaults are in docker-compose.yml)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0

# Maps
MAPS_API_KEY=AIzaSyBK52NrEXWYjmGLRkKOpjndjDxuT4PuB8U

# Optional Services
TRACK_SCANNER_URL=http://track-scanner.herokuapp.com

