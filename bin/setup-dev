#!/bin/bash
# Skyderby Development Environment Setup Script
# This script sets up everything needed to run and test the Skyderby application locally

set -e  # Exit on error

echo "🚀 Setting up Skyderby development environment..."

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

print_step() {
    echo -e "${BLUE}▶ $1${NC}"
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

# Check if Homebrew is installed
if ! command -v brew &> /dev/null; then
    echo "Homebrew is not installed. Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
print_success "Homebrew is installed"

# Install rbenv if not present
print_step "Checking Ruby version manager..."
if ! command -v rbenv &> /dev/null; then
    print_step "Installing rbenv..."
    brew install rbenv ruby-build
    echo 'eval "$(rbenv init - bash)"' >> ~/.bash_profile
    export PATH="$HOME/.rbenv/shims:$PATH"
    eval "$(rbenv init - bash)"
    print_success "rbenv installed"
else
    print_success "rbenv is already installed"
fi

# Install Ruby 3.2.3
print_step "Installing Ruby 3.2.3..."
if ! rbenv versions | grep -q "3.2.3"; then
    rbenv install 3.2.3
    print_success "Ruby 3.2.3 installed"
else
    print_success "Ruby 3.2.3 already installed"
fi

# Set local Ruby version
rbenv local 3.2.3
print_success "Set Ruby 3.2.3 for this project"

# Install PostgreSQL
print_step "Installing PostgreSQL..."
if ! brew list postgresql@15 &> /dev/null; then
    brew install postgresql@15
    print_success "PostgreSQL 15 installed"
else
    print_success "PostgreSQL 15 already installed"
fi

# Add PostgreSQL to PATH
if ! grep -q "postgresql@15" ~/.bash_profile; then
    echo 'export PATH="/opt/homebrew/opt/postgresql@15/bin:$PATH"' >> ~/.bash_profile
fi
export PATH="/opt/homebrew/opt/postgresql@15/bin:$PATH"

# Start PostgreSQL service
print_step "Starting PostgreSQL..."
brew services start postgresql@15
print_success "PostgreSQL service started"

# Install Yarn
print_step "Installing Yarn..."
if ! command -v yarn &> /dev/null; then
    brew install yarn
    print_success "Yarn installed"
else
    print_success "Yarn already installed"
fi

# Install eccodes (for weather data processing)
print_step "Installing eccodes library..."
if ! brew list eccodes &> /dev/null; then
    brew install eccodes
    print_success "eccodes installed"
else
    print_success "eccodes already installed"
fi

# Install vips (for image processing)
print_step "Installing vips library..."
if ! brew list vips &> /dev/null; then
    brew install vips
    print_success "vips installed"
else
    print_success "vips already installed"
fi

# Install Bundler
print_step "Installing Bundler..."
gem install bundler
print_success "Bundler installed"

# Install Ruby dependencies
print_step "Installing Ruby gems..."
export LDFLAGS="-L/opt/homebrew/opt/postgresql@15/lib"
export CPPFLAGS="-I/opt/homebrew/opt/postgresql@15/include"
bundle install
print_success "Ruby gems installed"

# Create .env file if it doesn't exist
print_step "Setting up environment variables..."
if [ ! -f .env ]; then
    cat > .env << 'EOF'
DB_NAME=skyderby_development
DB_TEST_NAME=skyderby_test
DB_HOST=localhost
DB_USERNAME=$(whoami)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=12
MAPS_API_KEY=AIzaSyBK52NrEXWYjmGLRkKOpjndjDxuT4PuB8U
TRACK_SCANNER_URL=http://track-scanner.herokuapp.com

# Optional: Add these if you need them
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# HONEYBADGER_API_KEY=
# SHRINE_S3_BUCKET=
# SHRINE_S3_ACCESS_KEY=
# SHRINE_S3_SECRET_KEY=
# SHRINE_S3_REGION=eu-west-1
EOF
    print_success ".env file created"
else
    print_success ".env file already exists"
fi

# Remove package-lock.json if it exists (we use yarn.lock)
print_step "Cleaning up npm lock file..."
if [ -f package-lock.json ]; then
    rm -f package-lock.json
    print_success "Removed package-lock.json (using yarn.lock)"
fi

# Install Node dependencies
print_step "Installing Node.js dependencies..."
yarn install
print_success "Node.js dependencies installed"

# Setup database
print_step "Setting up database..."
bundle exec rails db:create db:schema:load
print_success "Database created and schema loaded"

# Optional: Seed database
print_step "Seeding database (optional)..."
if bundle exec rails db:seed 2>/dev/null; then
    print_success "Database seeded"
else
    print_warning "Database seeding skipped or failed (this is optional)"
fi

echo ""
echo -e "${GREEN}═══════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}✓ Setup complete!${NC}"
echo -e "${GREEN}═══════════════════════════════════════════════════════${NC}"
echo ""
echo "To start the application:"
echo "  1. Press F5 in VS Code and select 'Rails + Webpack (Full Stack)'"
echo "  OR"
echo "  2. Run manually:"
echo "     Terminal 1: bundle exec rails server -p 3000"
echo "     Terminal 2: ./bin/webpacker-dev-server"
echo ""
echo "To run tests:"
echo "  bundle exec rails test"
echo ""
echo "The application will be available at: http://localhost:3000"
echo ""
echo "Optional: Install Redis for background jobs:"
echo "  brew install redis"
echo "  brew services start redis"
echo ""
